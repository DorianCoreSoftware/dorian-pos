{
  "expo": {
    "name": "Dorian POS",
    "slug": "dorian-pos",
    "version": "1.3.0",
    "newArchEnabled": false,
    "orientation": "default",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_ADVERTISE"
      ],
      "package": "com.burgerkong.pos"
    },
    "web": {
      "favicon": "./assets/app-icon.png"
    },
    "plugins": [
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#2563EB",
          "defaultChannel": "web-orders"
        }
      ],
      [
        "with-rn-bluetooth-classic",
        {
          "peripheralUsageDescription": "Dorian POS necesita Bluetooth para conectarse a la impresora de tickets.",
          "alwaysUsageDescription": "Dorian POS necesita Bluetooth para imprimir tickets."
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "14f8bcc3-9327-4987-b505-899cc734c274"
      }
    }
  }
}
