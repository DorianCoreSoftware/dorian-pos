# Identidad del build Android.
# Burger Kong DEV/PROD puede omitir esta variable mientras use su Firebase actual.
DORIAN_ANDROID_APPLICATION_ID=com.example.client.pos

# Nombre nativo opcional del build white-label.
DORIAN_APP_NAME=Mi Negocio POS

# development agrega automáticamente .dev al applicationId efectivo.
APP_VARIANT=production

# Solo para validar un google-services.json alternativo sin reemplazar
# temporalmente el archivo del proyecto.
# DORIAN_GOOGLE_SERVICES_FILE=C:/ruta/google-services.json
