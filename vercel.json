{
  "buildCommand": "npx expo export --platform web",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/pedido/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/recompensas/:path*",
      "destination": "/index.html"
    }
  ]
}
